  "claims": [
    {
      "claim_id": "CL-01",
      "section_id": "SEC-01",
      "text": "HTTP is a request-response protocol in the client-server model.",
      "claim_type": "factual",
      "source_ids": [
        "SRC-001"
      ]
    },
    {
      "claim_id": "CL-02",
      "section_id": "SEC-02",
      "text": "HTTP is a stateless protocol that does not require the web server to retain user status across multiple requests.",
      "claim_type": "factual",
      "source_ids": [
        "SRC-001"
      ]
    },
    {
      "claim_id": "CL-03",
      "section_id": "SEC-03",
      "text": "GET is defined as a safe, read-only request method.",
      "claim_type": "factual",
      "source_ids": [
        "SRC-001"
      ]
    },
    {
      "claim_id": "CL-04",
      "section_id": "SEC-03",
      "text": "POST is defined as a cacheable request method used to submit data.",
      "claim_type": "factual",
      "source_ids": [
        "SRC-001"
      ]
    },
    {
      "claim_id": "CL-05",
      "section_id": "SEC-04",
      "text": "A 2xx status indicates that the action requested by the client was received, understood, and accepted.",
      "claim_type": "factual",
      "source_ids": [
        "SRC-002"
      ]
    },
    {
      "claim_id": "CL-06",
      "section_id": "SEC-04",
      "text": "A 4xx status code is for situations where an error seems to have been caused by the client.",
      "claim_type": "factual",
      "source_ids": [
        "SRC-002"
      ]
    },
    {
      "claim_id": "CL-07",
      "section_id": "SEC-04",
      "text": "A 5xx status indicates that the server is aware it encountered an error or is incapable of performing the request.",
      "claim_type": "factual",
      "source_ids": [
        "SRC-002"
      ]
    }
  ],
