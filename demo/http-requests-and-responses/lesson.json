        "LO-02"
      ],
      "content_blocks": [
        {
          "type": "takeaway",
          "content": "HTTP is a stateless request-response protocol running in a client-server model.",
          "items": [],
          "label": null,
          "visual_type": null,
          "elements": [],
          "connections": [],
          "rows": [],
          "caption": null,
          "alt_text": null
        },
        {
          "type": "definition",
          "content": "Protocol: A set of rules defining how messages are formatted and exchanged between computers.",
          "items": [],
          "label": null,
          "visual_type": null,
          "elements": [],
          "connections": [],
          "rows": [],
          "caption": null,
          "alt_text": null
        },
        {
          "type": "definition",
          "content": "Client: The user agent, such as a web browser, that initiates requests.",
          "items": [],
          "label": null,
          "visual_type": null,
          "elements": [],
          "connections": [],
          "rows": [],
          "caption": null,
          "alt_text": null
        },
        {
          "type": "definition",
          "content": "Server: The host system that receives requests, processes them, and returns responses.",
          "items": [],
          "label": null,
          "visual_type": null,
          "elements": [],
          "connections": [],
          "rows": [],
          "caption": null,
          "alt_text": null
        },
        {
          "type": "definition",
          "content": "Stateless Protocol: A protocol where the server does not retain status information about each user across multiple requests.",
          "items": [],
          "label": null,
          "visual_type": null,
          "elements": [],
          "connections": [],
          "rows": [],
          "caption": null,
