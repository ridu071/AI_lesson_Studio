        "LO-02"
      ],
      "content_blocks": [
        {
          "type": "takeaway",
          "content": "HTTP response status codes tell the client whether a request succeeded or failed, and who is responsible.",
          "items": [],
          "label": null,
          "visual_type": null,
          "elements": [],
          "connections": [],
          "rows": [],
          "caption": null,
          "alt_text": null
        },
        {
          "type": "visual",
          "content": "",
          "items": [],
          "label": null,
          "visual_type": "labeled_diagram",
          "elements": [
            "Status Code Categories",
            "2xx Success",
            "4xx Client Error",
            "5xx Server Error"
          ],
          "connections": [
            "Status Code Categories -> 2xx Success: includes",
            "Status Code Categories -> 4xx Client Error: includes",
            "Status Code Categories -> 5xx Server Error: includes"
          ],
          "rows": [],
          "caption": "The major response code categories.",
          "alt_text": "A labeled diagram showing status categories broken into 2xx, 4xx, and 5xx."
        },
        {
          "type": "explanation",
          "content": "A 2xx status indicates that the client request was successfully received, understood, and accepted. A 4xx status indicates an error caused by the client. A 5xx status indicates the server encountered an error.",
