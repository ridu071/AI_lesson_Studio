# Copy this file to ".env" (same folder) and edit the copy.
# NEVER commit ".env" to Git. It is listed in .gitignore.

APP_ENV=development

# LLM used by the QC evaluators. Get a key from Google AI Studio.
# Free-tier keys may let the provider use prompts for training: do not send
# real student data through a free-tier key.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
# Pause between calls (seconds). Raise it if you hit free-tier rate limits.
LLM_MIN_INTERVAL_SECONDS=0

# Hard rule from the project spec: mandatory lesson content must fit in 45 minutes.
MAX_LESSON_MINUTES=45

# Starting thresholds only. We calibrate them against the benchmark dataset later.
QC1_MIN_SCORE=80
QC2_MIN_SCORE=80
